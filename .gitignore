# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environment
backend/venv/

# Environment configuration
backend/.env
backend/.env.local
backend/.env.development
backend/.env.production
backend/.env.staging

# User uploads (keep directory using .gitkeep if wanted, but do not track uploaded files)
backend/uploads/*
!backend/uploads/.gitkeep

# IDE and Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS temporary files
.DS_Store
Thumbs.db

# Log files
*.log
backend/*.log
frontend/*.log
